<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KapukaApp.ViewModels"
             xmlns:models="clr-namespace:KapukaApp.Models"
             x:Class="KapukaApp.Views.HistoryPage"
             x:DataType="vm:HistoryViewModel"
             BackgroundColor="#f0f5f0"
             Title="History">

    <RefreshView Command="{Binding LoadDataCommand}" IsRefreshing="{Binding IsBusy}">
        <Grid>
            <!-- Main List -->
            <ScrollView>
                <VerticalStackLayout Spacing="16" Padding="16" MaximumWidthRequest="800">

                    <!-- Filters -->
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="8"
                                               BindableLayout.ItemsSource="{Binding Filters}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Button Text="{Binding .}"
                                            BackgroundColor="#e0e8e0" TextColor="#01312D"
                                            FontSize="12" CornerRadius="20" HeightRequest="36"
                                            Padding="16,0" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <!-- Grouped Requests -->
                    <VerticalStackLayout Spacing="16"
                                         BindableLayout.ItemsSource="{Binding FilteredRequests}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:RequestGroup">
                                <VerticalStackLayout Spacing="8">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="{Binding StatusIcon}" FontSize="16" />
                                        <Label Text="{Binding Status}" FontSize="16"
                                               FontAttributes="Bold" TextColor="{Binding StatusColor}" />
                                        <Label Text="{Binding Count, StringFormat='({0})'}"
                                               FontSize="13" TextColor="#6b9c96" />
                                    </HorizontalStackLayout>

                                    <VerticalStackLayout Spacing="8"
                                                         BindableLayout.ItemsSource="{Binding Requests}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:ServiceRequest">
                                                <Border Padding="14" BackgroundColor="White"
                                                        StrokeShape="RoundRectangle 12"
                                                        Stroke="#e0e8e0">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}, Path=ShowDetailCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                        <Label Grid.Column="0" Text="{Binding TypeIcon}"
                                                               FontSize="22" VerticalOptions="Center" />
                                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                            <Label Text="{Binding Type}" FontSize="14"
                                                                   FontAttributes="Bold" TextColor="#01312D" />
                                                            <Label Text="{Binding CarNumber}" FontSize="11"
                                                                   TextColor="#6b9c96" />
                                                        </VerticalStackLayout>
                                                        <VerticalStackLayout Grid.Column="2" Spacing="2">
                                                            <Label Text="{Binding Amount, StringFormat='R{0:F0}'}"
                                                                   FontSize="14" FontAttributes="Bold"
                                                                   TextColor="#01312D" />
                                                            <Label Text="{Binding Status}" FontSize="11"
                                                                   TextColor="{Binding StatusColor}" />
                                                        </VerticalStackLayout>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

            <!-- Detail Modal Overlay -->
            <Grid IsVisible="{Binding ShowDetail}" BackgroundColor="#80000000"
                  Padding="20">
                <Border VerticalOptions="Center" MaximumWidthRequest="480"
                        BackgroundColor="White" StrokeShape="RoundRectangle 20"
                        Stroke="Transparent" Padding="24">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding SelectedRequest.Type}" FontSize="20"
                               FontAttributes="Bold" TextColor="#01312D" />
                        <Label Text="{Binding SelectedRequest.Status}" FontSize="14"
                               TextColor="{Binding SelectedRequest.StatusColor}" />

                        <BoxView HeightRequest="1" Color="#e0e8e0" />

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                            <Label Grid.Row="0" Grid.Column="0" Text="Amount" FontSize="12" TextColor="#6b9c96" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding SelectedRequest.Amount, StringFormat='R{0:F0}'}"
                                   FontSize="14" FontAttributes="Bold" TextColor="#01312D" />
                            <Label Grid.Row="1" Grid.Column="0" Text="Vehicle" FontSize="12" TextColor="#6b9c96" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding SelectedRequest.CarNumber}"
                                   FontSize="14" FontAttributes="Bold" TextColor="#01312D" />
                            <Label Grid.Row="2" Grid.Column="0" Text="Date" FontSize="12" TextColor="#6b9c96" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding SelectedRequest.RequestDate}"
                                   FontSize="14" FontAttributes="Bold" TextColor="#01312D" />
                        </Grid>

                        <!-- Progress (for approved/sent/completed) -->
                        <VerticalStackLayout Spacing="4"
                                             IsVisible="{Binding SelectedRequest.IsPayable}">
                            <Grid ColumnDefinitions="*,*">
                                <Label Text="{Binding SelectedRequest.DisplayRepaid, StringFormat='Repaid: R{0:F0}'}"
                                       FontSize="11" TextColor="#3A7717" />
                                <Label Text="{Binding SelectedRequest.DisplayRemaining, StringFormat='Remaining: R{0:F0}'}"
                                       FontSize="11" TextColor="Red" HorizontalTextAlignment="End" />
                            </Grid>
                            <ProgressBar Progress="{Binding SelectedRequest.Progress}"
                                         ProgressColor="#bff202" HeightRequest="6" />
                        </VerticalStackLayout>

                        <Button Text="Close" Command="{Binding CloseDetailCommand}"
                                BackgroundColor="#01312D" TextColor="White"
                                CornerRadius="12" HeightRequest="44" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </RefreshView>

</ContentPage>
