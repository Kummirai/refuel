<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KapukaApp.ViewModels"
             xmlns:models="clr-namespace:KapukaApp.Models"
             x:Class="KapukaApp.Views.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             BackgroundColor="#f0f5f0"
             Title="Kapuka">

    <RefreshView Command="{Binding LoadDataCommand}" IsRefreshing="{Binding IsBusy}">
        <ScrollView>
            <VerticalStackLayout Spacing="16" Padding="16" MaximumWidthRequest="800">

                <!-- Header -->
                <VerticalStackLayout Spacing="2">
                    <Label Text="Welcome back," FontSize="14" TextColor="#6b9c96" />
                    <Label Text="{Binding Profile.Name}" FontSize="24" FontAttributes="Bold"
                           TextColor="#01312D" />
                </VerticalStackLayout>

                <!-- Stats Cards -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 16"
                            Stroke="Transparent" BackgroundColor="White" Padding="14">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Stats.TotalRequests}" FontSize="28"
                                   FontAttributes="Bold" TextColor="#01312D" />
                            <Label Text="Requests" FontSize="11" TextColor="#6b9c96" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" StrokeShape="RoundRectangle 16"
                            Stroke="Transparent" BackgroundColor="White" Padding="14">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding ActiveLoan.TotalRepayable, StringFormat='R{0:F0}'}"
                                   FontSize="28" FontAttributes="Bold" TextColor="#3A7717"
                                   IsVisible="{Binding HasActiveLoan}" />
                            <Label Text="Loan" FontSize="11" TextColor="#6b9c96" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" StrokeShape="RoundRectangle 16"
                            Stroke="Transparent" BackgroundColor="White" Padding="14">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Profile.Rating, StringFormat='{0:F1}'}"
                                   FontSize="28" FontAttributes="Bold" TextColor="#bff202" />
                            <Label Text="Rating" FontSize="11" TextColor="#6b9c96" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Quick Actions -->
                <Label Text="Quick Actions" FontSize="16" FontAttributes="Bold"
                       TextColor="#01312D" Margin="0,8,0,0" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Grid.Column="0" Text="⛽ Request Fuel"
                            Command="{Binding RequestFuelCommand}"
                            BackgroundColor="#01312D" TextColor="White"
                            FontSize="14" FontAttributes="Bold"
                            CornerRadius="16" HeightRequest="70" />
                    <Button Grid.Column="1" Text="🧽 Car Wash"
                            Command="{Binding RequestCarWashCommand}"
                            BackgroundColor="#3A7717" TextColor="White"
                            FontSize="14" FontAttributes="Bold"
                            CornerRadius="16" HeightRequest="70" />
                </Grid>

                <!-- Active Loan -->
                <Border IsVisible="{Binding HasActiveLoan}" Padding="16"
                        BackgroundColor="White" StrokeShape="RoundRectangle 16"
                        Stroke="Transparent">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Active Loan" FontSize="14" FontAttributes="Bold"
                               TextColor="#01312D" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{Binding ActiveLoan.Type}"
                                   FontSize="12" TextColor="#6b9c96" />
                            <Label Grid.Column="1" Text="{Binding ActiveLoan.DailyPayment, StringFormat='R{0:F2}/day'}"
                                   FontSize="12" FontAttributes="Bold" TextColor="#3A7717" />
                        </Grid>
                        <ProgressBar Progress="{Binding ActiveLoan.Progress}"
                                     ProgressColor="#bff202" HeightRequest="8" />
                        <Grid ColumnDefinitions="*,*">
                            <Label Grid.Column="0" Text="{Binding ActiveLoan.RepaidAmount, StringFormat='Paid: R{0:F0}'}"
                                   FontSize="11" TextColor="#3A7717" />
                            <Label Grid.Column="1" Text="{Binding ActiveLoan.RemainingBalance, StringFormat='Remaining: R{0:F0}'}"
                                   FontSize="11" TextColor="Red" HorizontalTextAlignment="End" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Recent Requests -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Recent Requests" FontSize="16"
                           FontAttributes="Bold" TextColor="#01312D" />
                    <Label Grid.Column="1" Text="See All" FontSize="13"
                           TextColor="#3A7717" FontAttributes="Bold">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ViewHistoryCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <VerticalStackLayout Spacing="10"
                                     BindableLayout.ItemsSource="{Binding RecentRequests}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ServiceRequest">
                            <Border Padding="14" BackgroundColor="White"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="#e0e8e0">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Label Grid.Column="0" Text="{Binding TypeIcon}"
                                           FontSize="22" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding Type}" FontSize="14"
                                               FontAttributes="Bold" TextColor="#01312D" />
                                        <Label Text="{Binding CarNumber}" FontSize="11"
                                               TextColor="#6b9c96" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" Spacing="2"
                                                         HorizontalOptions="End">
                                        <Label Text="{Binding Amount, StringFormat='R{0:F0}'}"
                                               FontSize="14" FontAttributes="Bold"
                                               TextColor="#01312D" />
                                        <Label Text="{Binding Status}" FontSize="11"
                                               TextColor="{Binding StatusColor}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
