<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KapukaApp.ViewModels"
             xmlns:models="clr-namespace:KapukaApp.Models"
             x:Class="KapukaApp.Views.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             BackgroundColor="#eafde7"
             Title="Kapuka">

    <Grid>
        <!-- Background decorative blobs -->
        <Ellipse Fill="#bff202" Opacity="0.08"
                 WidthRequest="300" HeightRequest="300"
                 HorizontalOptions="End" VerticalOptions="Start"
                 Margin="0,-80,-80,0" />
        <Ellipse Fill="#3A7717" Opacity="0.06"
                 WidthRequest="350" HeightRequest="350"
                 HorizontalOptions="Start" VerticalOptions="End"
                 Margin="-100,0,0,-100" />
        <Ellipse Fill="#72bf00" Opacity="0.05"
                 WidthRequest="250" HeightRequest="250"
                 HorizontalOptions="Center" VerticalOptions="Center" />

        <RefreshView Command="{Binding LoadDataCommand}" IsRefreshing="{Binding IsBusy}">
            <ScrollView>
                <VerticalStackLayout Spacing="16" Padding="16" MaximumWidthRequest="800">

                    <!-- Header -->
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Welcome back," FontSize="13" TextColor="#6b9c96" />
                        <Label Text="{Binding Profile.Name, TargetNullValue='Driver'}"
                               FontSize="22" FontAttributes="Bold" TextColor="#01312D" />
                    </VerticalStackLayout>

                    <!-- Stats Cards (2x2 grid) -->
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                          RowSpacing="10" ColumnSpacing="10">
                        <Border Grid.Row="0" Grid.Column="0"
                                StrokeShape="RoundRectangle 16"
                                Stroke="#bff202" StrokeThickness="1"
                                BackgroundColor="White" Padding="14">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Stats.TotalRequests}"
                                       FontSize="26" FontAttributes="Bold"
                                       TextColor="#01312D" />
                                <Label Text="Total Requests" FontSize="11"
                                       TextColor="#6b9c96" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1"
                                StrokeShape="RoundRectangle 16"
                                Stroke="#bff202" StrokeThickness="1"
                                BackgroundColor="White" Padding="14">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Profile.TotalSpent, StringFormat='R{0:F0}'}"
                                       FontSize="26" FontAttributes="Bold"
                                       TextColor="#3A7717" />
                                <Label Text="Total Spent" FontSize="11"
                                       TextColor="#6b9c96" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="0"
                                StrokeShape="RoundRectangle 16"
                                Stroke="#bff202" StrokeThickness="1"
                                BackgroundColor="White" Padding="14">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Stats.ActiveLoans}"
                                       FontSize="26" FontAttributes="Bold"
                                       TextColor="#01312D" />
                                <Label Text="Active Loans" FontSize="11"
                                       TextColor="#6b9c96" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1"
                                StrokeShape="RoundRectangle 16"
                                Stroke="#bff202" StrokeThickness="1"
                                BackgroundColor="White" Padding="14">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Profile.Rating, StringFormat='{0:F1}'}"
                                       FontSize="26" FontAttributes="Bold"
                                       TextColor="#bff202" />
                                <Label Text="Rating" FontSize="11"
                                       TextColor="#6b9c96" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Quick Actions -->
                    <Label Text="Quick Actions" FontSize="16" FontAttributes="Bold"
                           TextColor="#01312D" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Border Grid.Column="0" StrokeShape="RoundRectangle 16"
                                Stroke="Transparent">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#01312D" Offset="0.0" />
                                    <GradientStop Color="#3A7717" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Button Text="⛽  Request Fuel"
                                    Command="{Binding RequestFuelCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="White" FontSize="13"
                                    FontAttributes="Bold"
                                    HeightRequest="60" />
                        </Border>
                        <Border Grid.Column="1" StrokeShape="RoundRectangle 16"
                                Stroke="Transparent">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3A7717" Offset="0.0" />
                                    <GradientStop Color="#72bf00" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Button Text="🧽  Car Wash"
                                    Command="{Binding RequestCarWashCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="White" FontSize="13"
                                    FontAttributes="Bold"
                                    HeightRequest="60" />
                        </Border>
                    </Grid>

                    <!-- Active Loan Banner -->
                    <Border IsVisible="{Binding HasActiveLoan}"
                            StrokeShape="RoundRectangle 16"
                            Stroke="Transparent" Padding="16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#bff202" Offset="0.0" />
                                <GradientStop Color="#72bf00" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Active Loan" FontSize="15"
                                   FontAttributes="Bold" TextColor="#01312D" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="{Binding ActiveLoan.Type}"
                                       FontSize="12" TextColor="#01312D" />
                                <Label Grid.Column="1"
                                       Text="{Binding ActiveLoan.DailyPayment, StringFormat='R{0:F2}/day'}"
                                       FontSize="12" FontAttributes="Bold"
                                       TextColor="#01312D" />
                            </Grid>
                            <ProgressBar Progress="{Binding ActiveLoan.Progress}"
                                         ProgressColor="#01312D"
                                         HeightRequest="6" />
                            <Grid ColumnDefinitions="*,*">
                                <Label Grid.Column="0"
                                       Text="{Binding ActiveLoan.RepaidAmount, StringFormat='Paid: R{0:F0}'}"
                                       FontSize="11" TextColor="#01312D" />
                                <Label Grid.Column="1"
                                       Text="{Binding ActiveLoan.RemainingBalance, StringFormat='Remaining: R{0:F0}'}"
                                       FontSize="11" TextColor="#01312D"
                                       HorizontalTextAlignment="End" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Recent Requests -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Recent Requests" FontSize="16"
                               FontAttributes="Bold" TextColor="#01312D" />
                        <Label Grid.Column="1" Text="See All" FontSize="13"
                               TextColor="#3A7717" FontAttributes="Bold">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding ViewHistoryCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <VerticalStackLayout Spacing="10"
                        BindableLayout.ItemsSource="{Binding RecentRequests}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ServiceRequest">
                                <Border Padding="14" BackgroundColor="White"
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="#bff202" StrokeThickness="1">
                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          ColumnSpacing="12">
                                        <Label Grid.Column="0"
                                               Text="{Binding TypeIcon}"
                                               FontSize="22"
                                               VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1"
                                                             Spacing="2">
                                            <Label Text="{Binding Type}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="#01312D" />
                                            <Label Text="{Binding CarNumber}"
                                                   FontSize="11"
                                                   TextColor="#6b9c96" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2"
                                                             Spacing="2"
                                                             HorizontalOptions="End">
                                            <Label Text="{Binding Amount, StringFormat='R{0:F0}'}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="#01312D" />
                                            <Label Text="{Binding Status}"
                                                   FontSize="11"
                                                   TextColor="{Binding StatusColor}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Loading indicator -->
                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="#3A7717" HeightRequest="30" />

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
