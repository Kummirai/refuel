<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KapukaApp.ViewModels"
             x:Class="KapukaApp.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="Profile"
             BackgroundColor="#eafde7">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Profile Header -->
            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                <Border WidthRequest="80" HeightRequest="80"
                        StrokeShape="RoundRectangle 40"
                        Stroke="#01312D" StrokeThickness="2"
                        BackgroundColor="White" HorizontalOptions="Center">
                    <Label Text="&#x1f464;" FontSize="36"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="{Binding Profile.Name}" FontSize="22"
                       FontAttributes="Bold" TextColor="#01312D"
                       HorizontalTextAlignment="Center" />
                <Label Text="{Binding Profile.Email}" FontSize="13"
                       TextColor="#6b9c96" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Driver Details Card -->
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 16"
                    Stroke="Transparent" Padding="20">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Driver Details" FontSize="16"
                           FontAttributes="Bold" TextColor="#01312D" />

                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                          RowSpacing="10" ColumnSpacing="16">
                        <Label Grid.Row="0" Grid.Column="0" Text="Vehicle"
                               FontSize="13" TextColor="#6b9c96" />
                        <Label Grid.Row="0" Grid.Column="1"
                               Text="{Binding Profile.CarNumber}"
                               FontSize="14" TextColor="#01312D" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Model"
                               FontSize="13" TextColor="#6b9c96" />
                        <Label Grid.Row="1" Grid.Column="1"
                               Text="{Binding Profile.CarModel}"
                               FontSize="14" TextColor="#01312D" />

                        <Label Grid.Row="2" Grid.Column="0" Text="Year"
                               FontSize="13" TextColor="#6b9c96" />
                        <Label Grid.Row="2" Grid.Column="1"
                               Text="{Binding Profile.CarYear}"
                               FontSize="14" TextColor="#01312D" />

                        <Label Grid.Row="3" Grid.Column="0" Text="Color"
                               FontSize="13" TextColor="#6b9c96" />
                        <Label Grid.Row="3" Grid.Column="1"
                               Text="{Binding Profile.CarColor}"
                               FontSize="14" TextColor="#01312D" />

                        <Label Grid.Row="4" Grid.Column="0" Text="Phone"
                               FontSize="13" TextColor="#6b9c96" />
                        <Label Grid.Row="4" Grid.Column="1"
                               Text="{Binding Profile.Phone}"
                               FontSize="14" TextColor="#01312D" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#e0e8e0" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Label Text="Verification" FontSize="13" TextColor="#6b9c96" />
                        <Label Grid.Column="1"
                               Text="{Binding Profile.VerificationStatus}"
                               FontSize="14" FontAttributes="Bold"
                               TextColor="#3A7717" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Stats Card -->
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 16"
                    Stroke="Transparent" Padding="20">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Stats" FontSize="16"
                           FontAttributes="Bold" TextColor="#01312D" />

                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" RowSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                            <Label Text="{Binding Profile.TotalRequests}"
                                   FontSize="24" FontAttributes="Bold"
                                   TextColor="#01312D" HorizontalTextAlignment="Center" />
                            <Label Text="Requests" FontSize="11"
                                   TextColor="#6b9c96" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                            <Label Text="{Binding Profile.Rating, StringFormat='{0:F1}'}"
                                   FontSize="24" FontAttributes="Bold"
                                   TextColor="#bff202" HorizontalTextAlignment="Center" />
                            <Label Text="Rating" FontSize="11"
                                   TextColor="#6b9c96" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                            <Label Text="{Binding Profile.TotalSpent, StringFormat='R{0:F0}'}"
                                   FontSize="24" FontAttributes="Bold"
                                   TextColor="#3A7717" HorizontalTextAlignment="Center" />
                            <Label Text="Total Spent" FontSize="11"
                                   TextColor="#6b9c96" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Change Password -->
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 16"
                    Stroke="Transparent" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Button Text="Change Password"
                            Command="{Binding ToggleChangePasswordCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#01312D"
                            FontAttributes="Bold"
                            BorderColor="#01312D"
                            BorderWidth="1"
                            CornerRadius="12"
                            HeightRequest="44" />

                    <VerticalStackLayout Spacing="10"
                                         IsVisible="{Binding ShowChangePassword}">
                        <Entry Placeholder="Current Password"
                               Text="{Binding CurrentPassword}"
                               IsPassword="True"
                               BackgroundColor="#f0f7ef" />
                        <Entry Placeholder="New Password"
                               Text="{Binding NewPassword}"
                               IsPassword="True"
                               BackgroundColor="#f0f7ef" />
                        <Entry Placeholder="Confirm New Password"
                               Text="{Binding ConfirmPassword}"
                               IsPassword="True"
                               BackgroundColor="#f0f7ef" />

                        <Label Text="{Binding ErrorMessage}"
                               TextColor="Red" FontSize="12" />
                        <Label Text="{Binding SuccessMessage}"
                               TextColor="#3A7717" FontSize="12" />

                        <Button Text="Save Password"
                                Command="{Binding SavePasswordCommand}"
                                BackgroundColor="#01312D" TextColor="White"
                                CornerRadius="12" HeightRequest="44" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Logout -->
            <Button Text="Logout" Command="{Binding LogoutCommand}"
                    BackgroundColor="#c0392b" TextColor="White"
                    CornerRadius="12" HeightRequest="44"
                    Margin="0,8,0,0" />

            <!-- Loading -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="#01312D" HeightRequest="40" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
