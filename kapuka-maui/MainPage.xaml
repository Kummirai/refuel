<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KapukaApp.MainPage"
             BackgroundColor="#01312D">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="20"
            VerticalOptions="Center">

            <Label
                x:Name="TitleLabel"
                Text="Kapuka"
                FontSize="36"
                FontAttributes="Bold"
                TextColor="#bff202"
                HorizontalOptions="Center" />

            <Label
                x:Name="VersionLabel"
                Text="v1.0.0"
                FontSize="16"
                TextColor="#eafde7"
                HorizontalOptions="Center" />

            <BoxView HeightRequest="1" Color="#3A7717" Margin="0,10" />

            <Label
                x:Name="StatusLabel"
                Text="Checking for updates..."
                FontSize="14"
                TextColor="#eafde7"
                HorizontalOptions="Center" />

            <ProgressBar
                x:Name="DownloadProgress"
                Progress="0"
                ProgressColor="#bff202"
                IsVisible="False"
                HeightRequest="6" />

            <Button
                x:Name="UpdateBtn"
                Text="Update Available — Tap to Install"
                IsVisible="False"
                BackgroundColor="#bff202"
                TextColor="#01312D"
                FontAttributes="Bold"
                FontSize="16"
                CornerRadius="12"
                HeightRequest="50"
                Clicked="OnUpdateClicked" />

            <Button
                x:Name="RetryBtn"
                Text="Retry"
                IsVisible="False"
                BackgroundColor="#3A7717"
                TextColor="White"
                FontSize="14"
                CornerRadius="12"
                HeightRequest="44"
                Clicked="OnRetryClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
