<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Kapuka Brand Colors -->
    <Color x:Key="KapukaPrimary">#01312D</Color>
    <Color x:Key="KapukaSecondary">#3A7717</Color>
    <Color x:Key="KapukaAccent">#bff202</Color>
    <Color x:Key="KapukaBackground">#eafde7</Color>
    <Color x:Key="KapukaSurface">White</Color>
    <Color x:Key="KapukaTextPrimary">#01312D</Color>
    <Color x:Key="KapukaTextSecondary">#6b9c96</Color>
    <Color x:Key="KapukaError">#c0392b</Color>
    <Color x:Key="KapukaSuccess">#3A7717</Color>
    <Color x:Key="KapukaWarning">#e67e22</Color>
    <Color x:Key="KapukaBorder">#e0e8e0</Color>
    <Color x:Key="KapukaInputBg">#f0f7ef</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="KapukaPrimaryBrush" Color="{StaticResource KapukaPrimary}" />
    <SolidColorBrush x:Key="KapukaSecondaryBrush" Color="{StaticResource KapukaSecondary}" />
    <SolidColorBrush x:Key="KapukaAccentBrush" Color="{StaticResource KapukaAccent}" />
    <SolidColorBrush x:Key="KapukaBackgroundBrush" Color="{StaticResource KapukaBackground}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />
</ResourceDictionary>
